# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file — it is already excluded via .gitignore.

# RPC endpoint for the Sepolia testnet (e.g. from Infura or Alchemy)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the deployer wallet (Sepolia test ETH only — never use a real-funds key)
PRIVATE_KEY=your_wallet_private_key_here

# Optional: for verifying the contract on Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key_here
